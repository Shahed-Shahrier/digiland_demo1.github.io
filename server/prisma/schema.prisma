generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String    @id @default(cuid())
  name       String
  email      String    @unique
  password   String
  role       UserRole
  phone      String?
  nid        String?
  address    String?
  createdAt  DateTime  @default(now())
  applications Application[] @relation("Applicant")
  auditLogs  AuditLog[]
}

model LandRecord {
  id              String   @id @default(cuid())
  ownerName       String
  plotNumber      String
  holdingNumber   String
  district        String
  upazila         String
  mouza           String
  landSize        String
  ownershipStatus String
  createdAt       DateTime @default(now())
}

model Application {
  id                   String   @id @default(cuid())
  applicant            User     @relation("Applicant", fields: [applicantId], references: [id])
  applicantId          String
  applicantName        String
  applicantNid         String
  applicantPhone       String
  applicantEmail       String
  applicantAddress     String
  plotNumber           String
  holdingNumber        String
  district             String
  upazila              String
  mouza                String
  landSize             String
  currentOwner         String
  proposedNewOwner     String
  transferType         String
  reason               String
  deedReference        String
  remarks              String?
  status               ApplicationStatus @default(Pending)
  assignedSurveyOfficerId String?
  comments             Comment[]
  verificationNotes    VerificationNote[]
  documents            Document[]
  statusHistory        Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Document {
  id          String   @id @default(cuid())
  name        String
  type        String
  size        Int
  documentType String
  uploadedAt  DateTime
  application Application @relation(fields: [applicationId], references: [id])
  applicationId String
}

model Comment {
  id            String   @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  authorId      String
  authorName    String
  authorRole    UserRole
  comment       String
  createdAt     DateTime @default(now())
}

model VerificationNote {
  id            String   @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id])
  applicationId String
  officerId     String
  officerName   String
  findings      String
  isVerified    Boolean
  createdAt     DateTime @default(now())
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  title         String
  message       String
  type          String
  read          Boolean  @default(false)
  applicationId String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  actorName     String
  actorRole     UserRole
  actionType    String
  details       String
  applicationId String?
  user          User?    @relation(fields: [userId], references: [id])
  userId        String?
}

enum UserRole {
  citizen
  land_officer
  survey_officer
  admin
}

enum ApplicationStatus {
  Pending
  Under_Review
  Clarification_Requested
  Verified
  Approved
  Rejected
}
