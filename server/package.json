{
  "name": "digiland-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch prisma --exec ts-node --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "4",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "morgan": "^1.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "prisma": "4",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  }
}
